{
  "format": "apex-pack",
  "manifestVersion": 1,
  "id": "calm-wikipedia",
  "name": "Calm Wikipedia",
  "version": "1.0.0",
  "description": "Easier reading on Wikipedia: a narrower text column, more space between lines and no fundraising banners.",
  "author": { "name": "Apex community" },
  "homepage": "https://github.com/3SENN/apex-packs",
  "contributes": {
    "boosts": [{ "id": "reading", "match": ["wikipedia.org"], "subdomains": true, "css": "boosts/reading.css" }]
  },
  "permissions": { "sites": ["wikipedia.org", "*.wikipedia.org"] }
}
